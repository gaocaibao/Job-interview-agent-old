# 后端环境变量示例：复制为 .env（本地）或在 veFaaS 控制台/CLI 注入（线上）
# 注意：.env 含密钥，禁止提交 git

# 应用
APP_ENV=production
DEBUG=false

# CORS：允许的前端域名，多个用英文逗号分隔（线上必须替换为前端实际域名）
CORS_ORIGINS=http://localhost:3000

# LLM Provider（公有大模型 API，按量计费）
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-2-16k
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# LLM 路由：逗号分隔的有序降级链，未配置 Key 的 Provider 自动跳过
LLM_FALLBACK_CHAIN=stepfun,deepseek,doubao
